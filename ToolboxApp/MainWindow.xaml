<Window x:Class="ToolboxApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工具箱" Width="1060" Height="680"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/icons/Toolbox.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <DockPanel>
        <!-- 顶部分类选项卡栏 -->
        <Border DockPanel.Dock="Top" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Background="#FAFAFA">
            <DockPanel Margin="8,0">
                <ToggleButton x:Name="BtnTopmost" Content="📌 置顶" DockPanel.Dock="Right"
                              VerticalAlignment="Center" Padding="8,4" Margin="0,0,4,0"
                              Click="BtnTopmost_Click" Style="{StaticResource TopmostToggleButton}"/>
                <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabCommon" Content="常用工具" Tag="common"
                             IsChecked="True" Click="TabButton_Click"
                             Style="{StaticResource TabBarButton}"/>
                <RadioButton x:Name="TabOther" Content="其他工具" Tag="other"
                             Click="TabButton_Click"
                             Style="{StaticResource TabBarButton}"/>
                <RadioButton x:Name="TabSystem" Content="系统工具" Tag="system"
                             Click="TabButton_Click"
                             Style="{StaticResource TabBarButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 下方内容区 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航列表 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0">
                <ListBox x:Name="NavList"
                         Style="{StaticResource NavListBox}"
                         ItemContainerStyle="{StaticResource NavListBoxItem}"
                         SelectionChanged="NavList_SelectionChanged"/>
            </Border>

            <!-- 右侧内容区域 -->
            <ContentControl x:Name="ContentArea" Grid.Column="1" Margin="10"/>
        </Grid>
    </DockPanel>
</Window>
