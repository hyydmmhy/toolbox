<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <StartupObject>ToolboxApp.Program</StartupObject>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ToolboxApp</RootNamespace>
    <AssemblyName>Toolbox</AssemblyName>
    <ApplicationIcon>Resources\icons\Toolbox.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0.0</Version>
    <AssemblyTitle>工具箱</AssemblyTitle>
    <Description>多功能工具箱</Description>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- 通用 NuGet 包 -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="tyme4net" Version="1.5.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.18.0" />
  </ItemGroup>

  <!-- 单文件打包时启用 Costura.Fody -->
  <ItemGroup Condition="'$(SingleFile)'=='true'">
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.8.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Drawing" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationClientsideProviders" />
    <Reference Include="UIAutomationProvider" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>

  <!-- SysMenu 嵌入资源 -->
  <ItemGroup>
    <EmbeddedResource Include="Views\SysMenu\Language.xml">
      <LogicalName>SysMenu.Language.xml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Views\SysMenu\SysMenu.xml">
      <LogicalName>SysMenu.SysMenu.xml</LogicalName>
    </EmbeddedResource>
    <!-- WinForms 表单资源名必须与类命名空间匹配 -->
    <EmbeddedResource Update="Views\SysMenu\Forms\*.resx">
      <ManifestResourceName>SysMenu.Forms.%(Filename)</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- OCR 字符集嵌入资源（PpOcrEngine 读取） -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\ocr_keys.txt">
      <LogicalName>Toolbox.ocr_keys.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 单文件发布：先把 OnnxRuntime 原生库 gzip 压缩（11 MB → 约 4.2 MB）再内嵌，减小 exe 体积 -->
  <Target Name="GzipOnnxRuntimeNative" BeforeTargets="BeforeBuild" Condition="'$(SingleFile)'=='true'">
    <PropertyGroup>
      <OrtNativeSource>$(NuGetPackageRoot)microsoft.ml.onnxruntime\1.18.0\runtimes\win-x64\native\onnxruntime.dll</OrtNativeSource>
      <OrtNativeGzip>$(IntermediateOutputPath)onnxruntime.dll.gz</OrtNativeGzip>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\build\gzip-ort.ps1&quot; -Source &quot;$(OrtNativeSource)&quot; -Target &quot;$(OrtNativeGzip)&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="$(OrtNativeGzip)">
        <LogicalName>Toolbox.onnxruntime.dll.gz</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>


  <!-- 资源文件：图标内嵌进程序集，避免在输出目录残留散文件 -->
  <ItemGroup>
    <Resource Include="Resources\icons\**" />
  </ItemGroup>

  <!--
    OnnxRuntime 包的 runtimes\win-x64\native 目录下带了两个 C++ 导入库
    （onnxruntime.lib / onnxruntime_providers_shared.lib），SDK 会把整个 native 目录
    当作运行时资产原样拷进 bin 和 publish 目录，但本应用只走托管绑定 + P/Invoke 加载 DLL，
    这两个 .lib 完全用不上（C# 项目不参与 C++ 链接）。构建/发布结束后清掉，避免污染输出。
  -->
  <Target Name="RemoveOnnxRuntimeLibFilesFromOutput"
          AfterTargets="CopyFilesToOutputDirectory;CopyFilesToPublishDirectory;Publish">
    <Exec Condition="Exists('$(PublishDir)') OR Exists('$(OutputPath)')"
          Command="powershell -NoProfile -Command &quot;try { Get-ChildItem -Path @('$(OutputPath)','$(PublishDir)') -Filter onnxruntime*.lib -File -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue } finally { exit 0 }&quot;" />
  </Target>

  <!--
    单文件发布（-p:SingleFile=true）时，Costura.Fody 已把所有托管程序集内嵌进 exe，
    原生 onnxruntime 也是 gzip 内嵌后运行时释放，
    因此 publish 目录里残留的散文件全部用不上——只留 Toolbox.exe 即可。
    这里统一清掉 exe 之外的一级散文件，保持输出目录干净。
  -->
  <Target Name="CleanSingleFilePublish" AfterTargets="Publish">
    <Exec Condition="Exists('$(PublishDir)Toolbox.exe') AND ('$(PublishSingleFile)' == 'true' OR '$(SingleFile)' == 'true')"
          Command="powershell -NoProfile -Command &quot;try { Get-ChildItem -Path '$(PublishDir)' -File | Where-Object { $_.Name -ne 'Toolbox.exe' } | Remove-Item -Force -ErrorAction SilentlyContinue } finally { exit 0 }&quot;" />
  </Target>

</Project>
