<UserControl x:Class="ToolboxApp.Views.Common.JsonFormatterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="JSON 输入" Foreground="#666666" Margin="0,0,0,8"/>
        <TextBox Grid.Row="1" x:Name="TxtInput" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="6,4"/>

        <WrapPanel Grid.Row="2" Margin="0,8">
            <Button Content="格式化" Click="Format_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="压缩" Click="Compress_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="清空" Click="Clear_Click" Padding="12,6"/>
        </WrapPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4">
            <TextBox x:Name="TxtSearch"
                     Width="250" MaxWidth="250" Height="32" Margin="0,0,6,0"/>
            <Button Content="上一个" Click="FindPrev_Click" Padding="8,4" Margin="0,0,4,0"/>
            <Button Content="下一个" Click="FindNext_Click" Padding="8,4"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="输出" Foreground="#666666" Margin="0,8,0,8"/>
        <TextBox Grid.Row="5" x:Name="TxtOutput" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap" IsReadOnly="True" VerticalContentAlignment="Top" Padding="6,4"/>

        <WrapPanel Grid.Row="6" Margin="0,8">
            <Button Content="复制结果" Click="Copy_Click" Padding="12,6" Margin="0,0,8,0"/>
        </WrapPanel>

        <Label Grid.Row="7" x:Name="LblStatus" Foreground="Gray"/>
    </Grid>
</UserControl>
