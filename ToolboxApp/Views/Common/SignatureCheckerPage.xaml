<UserControl x:Class="ToolboxApp.Views.Common.SignatureCheckerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ToolboxApp.Views.Common">
    <UserControl.Resources>
        <local:NotEmptyConverter x:Key="NotEmptyConverter"/>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBox x:Name="PathBox" Width="350"/>
                <Button Content="浏览..." Padding="8,4" Margin="8,0,0,0" Click="BrowseBtn_Click"/>
                <CheckBox x:Name="UnsignedOnlyCheck" Content="仅显示未签名文件" Margin="16,0,0,0" VerticalAlignment="Center" IsChecked="True"/>
                <CheckBox x:Name="PeOnlyCheck" Content="仅扫描PE文件" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="True"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="ScanBtn" Content="开始扫描" Padding="12,6" Click="ScanBtn_Click"/>
                <Label x:Name="StatusLabel" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="ResultGrid"
                  PreviewMouseRightButtonDown="ResultGrid_PreviewMouseRightButtonDown"
                  ContextMenuOpening="ResultGrid_ContextMenuOpening">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text, Converter={StaticResource NotEmptyConverter}}" Value="True">
                            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text}"/>
                            <Setter Property="ToolTipService.IsEnabled" Value="True"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSigned}" Value="False">
                            <Setter Property="Foreground" Value="Red"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="复制文件名" Click="CopyFileName_Click"/>
                    <MenuItem Header="文件属性" Click="FileProperties_Click"/>
                    <MenuItem Header="打开文件位置" Click="OpenFileLocation_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="2*"/>
                <DataGridTextColumn Header="签名" Binding="{Binding Signature}" Width="*"/>
                <DataGridTextColumn Header="签名者" Binding="{Binding Signer}" Width="2.5*"/>
                <DataGridTextColumn Header="签名时间" Binding="{Binding SignDate}" Width="2*"/>
                <DataGridTextColumn Header="文件路径" Binding="{Binding FilePath}" Width="2.5*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
