<UserControl x:Class="ToolboxApp.Views.Common.QrCodePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl>
        <!-- Tab 1: 生成二维码 -->
        <TabItem Header="生成二维码">
            <StackPanel Margin="16" MaxWidth="700">
                <TextBlock Text="二维码内容" Foreground="#666666" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtQrContent" Height="80"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="输入二维码内容"/>

                <TextBlock Text="二维码设置" Foreground="#666666" Margin="0,8,0,8"/>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="大小" VerticalAlignment="Center" Width="80"/>
                        <TextBox x:Name="TxtQrSize" Width="80" Text="300"/>
                        <TextBlock Text="纠错级别" VerticalAlignment="Center" Margin="24,0,0,0"/>
                        <ComboBox x:Name="CbErrorLevel" Width="60" Margin="8,0,0,0"
                                  SelectedIndex="1" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="L"/>
                            <ComboBoxItem Content="M"/>
                            <ComboBoxItem Content="Q"/>
                            <ComboBoxItem Content="H"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkAddLogo" Content="添加Logo" VerticalAlignment="Center"/>
                        <Button Content="选择Logo..." Padding="12,4" Margin="12,0,0,0"
                                Click="BtnSelectLogo_Click"/>
                        <TextBlock x:Name="TxtLogoPath" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="#999999" Text="未选择"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                    <Button Content="生成" Click="BtnGenerate_Click"/>
                    <Button Content="保存" Margin="8,0,0,0" Click="BtnSaveQr_Click"/>
                </StackPanel>

                <TextBlock Text="预览" Foreground="#666666" Margin="0,0,0,8"/>
                <Border BorderBrush="#DDDDDD" BorderThickness="1"
                        HorizontalAlignment="Center" Width="200" Height="200" Background="#F9F9F9">
                    <Image x:Name="ImgQrPreview" Stretch="Uniform"/>
                </Border>
            </StackPanel>
        </TabItem>

        <!-- Tab 2: 识别二维码 -->
        <TabItem Header="识别二维码">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16" MaxWidth="700">
                    <TextBlock Text="选择图片" Foreground="#666666" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="选择图片" Click="BtnSelectImage_Click"/>
                        <TextBlock x:Name="TxtImagePath" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="#999999" Text="未选择"/>
                    </StackPanel>

                    <TextBlock Text="图片预览" Foreground="#666666" Margin="0,0,0,8"/>
                    <Border BorderBrush="#DDDDDD" BorderThickness="1"
                            HorizontalAlignment="Center" Width="200" Height="200" Background="#F9F9F9"
                            Margin="0,0,0,8">
                        <Image x:Name="ImgDecodePreview" Stretch="Uniform"/>
                    </Border>

                    <TextBlock Text="识别结果" Foreground="#666666" Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtDecodeResult"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" MinHeight="100"
                             FontFamily="Consolas"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="复制结果" Click="BtnCopyDecodeResult_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
