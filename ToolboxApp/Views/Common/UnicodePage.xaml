<UserControl x:Class="ToolboxApp.Views.Common.UnicodePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="16">
    <DockPanel>
        <!-- 常见字符编码对照表 -->
        <TextBlock Text="常见字符编码对照表" Foreground="#666666" DockPanel.Dock="Bottom" Margin="0,8,0,8"/>
        <DataGrid x:Name="RefTable" DockPanel.Dock="Bottom"
                  CanUserReorderColumns="False" CanUserResizeRows="False"
                  CanUserSortColumns="False" GridLinesVisibility="All"
                  ColumnWidth="*">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="字符" Binding="{Binding C1}"/>
                <DataGridTextColumn Header="URL编码" Binding="{Binding E1}"/>
                <DataGridTextColumn Header="字符" Binding="{Binding C2}"/>
                <DataGridTextColumn Header="URL编码" Binding="{Binding E2}"/>
                <DataGridTextColumn Header="字符" Binding="{Binding C3}"/>
                <DataGridTextColumn Header="URL编码" Binding="{Binding E3}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 按钮行（在文本框下方） -->
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="Unicode转中文" Click="UnicodeToChinese_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="中文转Unicode" Click="ChineseToUnicode_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="URL解码" Click="UrlDecode_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="URL编码" Click="UrlEncode_Click" Padding="12,6"/>
        </WrapPanel>

        <!-- 输入/输出共用文本框 -->
        <TextBox x:Name="TxtInput" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"/>
    </DockPanel>
</UserControl>
