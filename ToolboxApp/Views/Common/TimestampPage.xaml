<UserControl x:Class="ToolboxApp.Views.Common.TimestampPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 时间戳 -> 时间 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="时间戳 -> 时间" Foreground="#666666" Margin="0,0,0,8"/>
            <TextBlock Text="时间戳（秒或毫秒）" Foreground="#666666" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtTimestampInput" Height="32"
                     PreviewTextInput="NumberOnly_PreviewTextInput"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="转换成时间日期" Click="BtnToDateTime_Click"/>
                <Button Content="当前时间戳" Margin="8,0,0,0" Click="BtnCurrentTimestamp_Click"/>
            </StackPanel>
            <TextBlock Text="转换结果" Foreground="#666666" Margin="0,12,0,4"/>
            <TextBox x:Name="TxtDateTimeOutput" Height="32" IsReadOnly="True"/>
            <TextBlock Text="毫秒" Foreground="#666666" Margin="0,8,0,4"/>
            <TextBox x:Name="TxtDateTimeMsOutput" Height="32" IsReadOnly="True"/>
        </StackPanel>

        <!-- 时间 -> 时间戳 -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="时间 -> 时间戳" Foreground="#666666" Margin="0,0,0,8"/>
            <WrapPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="年" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtYear" Width="80" Height="32" MaxLength="4"
                             PreviewTextInput="NumberOnly_PreviewTextInput" LostFocus="TxtYear_LostFocus"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="月" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtMonth" Width="60" Height="32" MaxLength="2"
                             PreviewTextInput="TxtMonth_PreviewTextInput" LostFocus="TxtMonth_LostFocus"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="日" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtDay" Width="60" Height="32" MaxLength="2"
                             PreviewTextInput="TxtDay_PreviewTextInput" LostFocus="TxtDay_LostFocus"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="时" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtHour" Width="60" Height="32" MaxLength="2"
                             PreviewTextInput="TxtHour_PreviewTextInput" LostFocus="TxtHour_LostFocus"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="分" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtMinute" Width="60" Height="32" MaxLength="2"
                             PreviewTextInput="TxtMinute_PreviewTextInput" LostFocus="TxtMinute_LostFocus"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="秒" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSecond" Width="60" Height="32" MaxLength="2"
                             PreviewTextInput="TxtSecond_PreviewTextInput" LostFocus="TxtSecond_LostFocus"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="毫秒" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtMillisecond" Width="60" Height="32" MaxLength="3"
                             PreviewTextInput="TxtMillisecond_PreviewTextInput" LostFocus="TxtMillisecond_LostFocus"/>
                </StackPanel>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="转换成时间戳" Click="BtnToTimestamp_Click"/>
                <Button Content="当前时间" Margin="8,0,0,0" Click="BtnCurrentTime_Click"/>
            </StackPanel>
            <TextBlock Text="转换结果（秒，10位）" Foreground="#666666" Margin="0,12,0,4"/>
            <TextBox x:Name="TxtTimestampOutput" Height="32" IsReadOnly="True"/>
            <TextBlock Text="转换结果（毫秒，13位）" Foreground="#666666" Margin="0,8,0,4"/>
            <TextBox x:Name="TxtTimestampMsOutput" Height="32" IsReadOnly="True"/>
        </StackPanel>
    </Grid>
</UserControl>
