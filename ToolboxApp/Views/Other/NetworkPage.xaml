<UserControl x:Class="ToolboxApp.Views.Other.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="16">
    <TabControl>
        <TabItem Header="IP配置">
            <DockPanel Margin="16">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                    <Button Content="查看IP配置" Click="BtnIpConfig_Click"/>
                    <Button Content="查看详细IP配置" Margin="8,0,0,0" Click="BtnIpConfigAll_Click"/>
                    <Button Content="复制结果" Margin="8,0,0,0" Click="BtnCopyIpConfig_Click"/>
                </StackPanel>
                <TextBox x:Name="TxtIpConfigOutput" Margin="0,12,0,0" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         AcceptsReturn="True" FontFamily="Consolas" TextWrapping="Wrap"/>
            </DockPanel>
        </TabItem>
        <TabItem Header="刷新DNS">
            <DockPanel Margin="16">
                <Button DockPanel.Dock="Top" Content="刷新DNS缓存" HorizontalAlignment="Left" Click="BtnFlushDns_Click"/>
                <TextBox x:Name="TxtFlushDnsOutput" Margin="0,12,0,0" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                         FontFamily="Consolas" TextWrapping="Wrap"/>
            </DockPanel>
        </TabItem>
        <TabItem Header="IPv4/Long转换">
            <StackPanel Margin="16">
                <TextBlock Text="IPv4 地址" Foreground="#666666" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtIPv4" Width="260" Height="32" HorizontalAlignment="Left"/>
                <TextBlock Text="Long 值" Foreground="#666666" Margin="0,12,0,4"/>
                <TextBox x:Name="TxtLong" Width="260" Height="32" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="IPv4→Long" Click="BtnIPv4ToLong_Click"/>
                    <Button Content="Long→IPv4" Margin="8,0,0,0" Click="BtnLongToIPv4_Click"/>
                </StackPanel>
            </StackPanel>
        </TabItem>
        <TabItem Header="域名转IP">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="域名" Foreground="#666666" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtDomain" Width="300" Height="32" HorizontalAlignment="Left"/>
                    <Button Content="解析" Margin="0,12,0,0" HorizontalAlignment="Left" Click="BtnResolveDomain_Click"/>
                </StackPanel>
                <TextBox x:Name="TxtDomainOutput" Margin="0,12,0,0" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                         FontFamily="Consolas" TextWrapping="Wrap"/>
            </DockPanel>
        </TabItem>
        <TabItem Header="Ping测试">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="主机" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPingHost" Width="260" Height="32"/>
                    </StackPanel>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="次数" Foreground="#666666" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPingCount" Width="80" Height="32" Text="4"/>
                    </StackPanel>
                    <Button Content="PING" Margin="12,18,0,0" Click="BtnPing_Click"/>
                </StackPanel>
                <TextBox x:Name="TxtPingOutput" Margin="0,12,0,0" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                         FontFamily="Consolas" TextWrapping="Wrap"/>
            </DockPanel>
        </TabItem>
        <TabItem Header="端口查询">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="端口号（多个用逗号分隔）" Foreground="#666666" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="TxtQueryPort" Width="260" Height="32"/>
                        <Button Content="查询" Margin="8,0,0,0" Click="BtnQueryPort_Click"/>
                        <Button Content="复制结果" Margin="8,0,0,0" Click="BtnCopyPortResult_Click"/>
                    </StackPanel>
                </StackPanel>
                <TextBox x:Name="TxtPortOutput" Margin="0,12,0,0" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         AcceptsReturn="True" FontFamily="Consolas" TextWrapping="Wrap"/>
            </DockPanel>
        </TabItem>
        <TabItem Header="防火墙管理">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="端口号" Foreground="#666666" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtFirewallPort" Width="200" Height="32" HorizontalAlignment="Left"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="查看端口" Margin="0,0,8,8" Click="BtnFwView_Click"/>
                        <Button Content="禁用端口" Margin="0,0,8,8" Click="BtnFwDisable_Click"/>
                        <Button Content="启用端口" Margin="0,0,8,8" Click="BtnFwEnable_Click"/>
                        <Button Content="删除端口" Margin="0,0,8,8" Click="BtnFwDelete_Click"/>
                        <Button Content="添加All" Margin="0,0,8,8" Click="BtnFwAddAll_Click"/>
                        <Button Content="添加Domain" Margin="0,0,8,8" Click="BtnFwAddDomain_Click"/>
                        <Button Content="添加Public" Margin="0,0,8,8" Click="BtnFwAddPublic_Click"/>
                        <Button Content="添加Private" Margin="0,0,8,8" Click="BtnFwAddPrivate_Click"/>
                    </WrapPanel>
                </StackPanel>
                <TextBox x:Name="TxtFirewallOutput" Margin="0,12,0,0" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                         FontFamily="Consolas" TextWrapping="Wrap"/>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
