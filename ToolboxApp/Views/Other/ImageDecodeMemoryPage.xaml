<UserControl x:Class="ToolboxApp.Views.Other.ImageDecodeMemoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="16">
    <UserControl.Resources>
        <Style x:Key="CellWithTooltip" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
            <TextBox x:Name="TxtDirPath" Width="300" Height="32"/>
            <Button Content="浏览" Margin="8,0,0,0" Click="BtnBrowse_Click"/>
            <Button x:Name="BtnScan" Content="开始扫描" Margin="8,0,0,0" Click="BtnScan_Click"/>
        </StackPanel>
        <TextBlock x:Name="LblStatus" DockPanel.Dock="Top" Margin="0,8,0,0" Foreground="#666666"/>
        <DataGrid x:Name="DgResults" Margin="0,8,0,0" Sorting="DgResults_Sorting">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="查看属性" Click="MenuProperties_Click"/>
                    <MenuItem Header="打开文件位置" Click="MenuOpenLocation_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="2.5*" ElementStyle="{StaticResource CellWithTooltip}"/>
                <DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="*" ElementStyle="{StaticResource CellWithTooltip}"/>
                <DataGridTextColumn Header="分辨率" Binding="{Binding Resolution}" Width="1.5*" ElementStyle="{StaticResource CellWithTooltip}"/>
                <DataGridTextColumn Header="解码内存" Binding="{Binding DecodeMemory}" Width="1.2*" SortMemberPath="DecodeMemoryBytes" ElementStyle="{StaticResource CellWithTooltip}"/>
                <DataGridTextColumn Header="文件大小" Binding="{Binding FileSize}" Width="1.2*" SortMemberPath="FileSizeBytes" ElementStyle="{StaticResource CellWithTooltip}"/>
                <DataGridTextColumn Header="修改时间" Binding="{Binding ModifiedTime}" Width="2*" ElementStyle="{StaticResource CellWithTooltip}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
