<UserControl x:Class="ToolboxApp.Views.Other.MemoryOptimizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="16">
    <Grid>
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#F7F9FC" BorderBrush="#E0E6EF" BorderThickness="1"
                        CornerRadius="4" Padding="12,10" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="物理内存总量" FontSize="12" Foreground="#666"/>
                        <TextBlock x:Name="TotalPhysText" Text="-" FontSize="18" FontWeight="Medium"
                                   Foreground="#1A1A1A" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#F7F9FC" BorderBrush="#E0E6EF" BorderThickness="1"
                        CornerRadius="4" Padding="12,10" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="可用内存" FontSize="12" Foreground="#666"/>
                        <TextBlock x:Name="AvailPhysText" Text="-" FontSize="18" FontWeight="Medium"
                                   Foreground="#1A1A1A" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#F7F9FC" BorderBrush="#E0E6EF" BorderThickness="1"
                        CornerRadius="4" Padding="12,10" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="缓存内存 (Standby)" FontSize="12" Foreground="#666"/>
                        <TextBlock x:Name="CacheText" Text="-" FontSize="18" FontWeight="Medium"
                                   Foreground="#1A1A1A" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#F7F9FC" BorderBrush="#E0E6EF" BorderThickness="1"
                        CornerRadius="4" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="已回收" FontSize="12" Foreground="#666"/>
                        <TextBlock x:Name="RecoveredText" Text="0 MB" FontSize="18" FontWeight="Medium"
                                   Foreground="#00A870" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="OptimizeBtn" Content="一键优化内存"
                        Padding="12,6" Click="OptimizeBtn_Click"/>
                <Button Grid.Column="1" x:Name="RefreshBtn" Content="刷新" Click="RefreshBtn_Click"
                        HorizontalAlignment="Left" Margin="10,0,0,0" Padding="16,6"/>
                <TextBlock Grid.Column="2" x:Name="StatusText" VerticalAlignment="Center"
                           Text="尚未执行" Foreground="#888" Margin="16,0,0,0"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>