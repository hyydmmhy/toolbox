<UserControl x:Class="ToolboxApp.Views.Other.CurlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="cURL 命令（支持 bash / cmd 格式，可多行）" Foreground="#666666" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" x:Name="TxtCommand" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" MinHeight="120"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,8">
            <Button x:Name="BtnExecute" Content="执行" Click="BtnExecute_Click"/>
            <Button x:Name="BtnClear" Content="清空" Margin="8,0,0,0" Click="BtnClear_Click"/>
            <Button x:Name="BtnCopy" Content="复制响应" Margin="8,0,0,0" Click="BtnCopy_Click"/>
            <Button x:Name="BtnSaveBody" Content="保存响应为文件" Margin="8,0,0,0" Click="BtnSaveBody_Click" IsEnabled="False"/>
            <CheckBox x:Name="ChkFormat" Content="格式化" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <CheckBox x:Name="ChkInsecureOverride" Content="跳过 SSL 验证" VerticalAlignment="Center" Margin="12,0,0,0"
                      ToolTip="勾选后强制跳过证书验证（等同 -k）；不勾选时按命令中的 -k 参数决定"/>
            <TextBlock x:Name="LblStatus" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#999"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="响应" Foreground="#666666" Margin="0,4,0,4"/>
        <TextBox Grid.Row="4" x:Name="TxtResponse" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" MinHeight="120"/>
    </Grid>
</UserControl>
