<UserControl x:Class="ToolboxApp.Views.Other.ScreenshotPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="16">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#666666" Margin="0,0,0,12">
            框选区域或全屏截图，自动复制到剪贴板。区域截图操作：左键拖拽框选 → 松开完成；右键或 ESC 取消。
        </TextBlock>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnRegion" Content="区域截图" Click="BtnRegion_Click"/>
            <Button x:Name="BtnFullScreen" Content="全屏截图" Margin="8,0,0,0" Click="BtnFullScreen_Click"/>
            <Button x:Name="BtnCopy" Content="复制到剪贴板" Margin="8,0,0,0" Click="BtnCopy_Click" IsEnabled="False"/>
            <Button x:Name="BtnSave" Content="保存为文件" Margin="8,0,0,0" Click="BtnSave_Click" IsEnabled="False"/>
            <CheckBox x:Name="ChkHideWindow" Content="截图时隐藏主窗口" IsChecked="True"
                      VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="LblStatus" DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#666666"/>
        <TextBlock DockPanel.Dock="Top" Text="预览" Foreground="#666666" Margin="0,0,0,4"/>
        <Border BorderBrush="#D0D0D0" BorderThickness="1" Background="#F9F9F9" CornerRadius="4">
            <Image x:Name="ImgPreview" Stretch="Uniform" StretchDirection="DownOnly"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"/>
        </Border>
    </DockPanel>
</UserControl>
