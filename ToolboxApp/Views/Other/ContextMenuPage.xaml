<UserControl x:Class="ToolboxApp.Views.Other.ContextMenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="16">
    <StackPanel>
        <TextBlock Text="为所有窗口添加增强右键菜单，鼠标中键点击任意窗口标题栏触发。"
                   Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="BtnToggle" Content="启用" Click="BtnToggle_Click"/>
            <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Margin="12,0,6,0"
                     VerticalAlignment="Center" Fill="#999999"/>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Text="已停止"/>
        </StackPanel>
        <TextBlock Text="菜单功能" Foreground="#666666" Margin="0,0,0,8"/>
        <TextBlock LineHeight="24" TextWrapping="Wrap">
            <Run Text="● 详细信息 — 查看窗口和进程详情"/><LineBreak/>
            <Run Text="● 窗口始终置顶"/><LineBreak/>
            <Run Text="● 突出窗口操作 (Aero Glass)"/><LineBreak/>
            <Run Text="● 更改标题"/><LineBreak/>
            <Run Text="● 保存窗口截图"/><LineBreak/>
            <Run Text="● 在资源管理器中进入程序路径"/><LineBreak/>
            <Run Text="● 调整窗口大小为（预设分辨率）"/><LineBreak/>
            <Run Text="● 按钮操作（禁用最小化/最大化/关闭按钮）"/>
        </TextBlock>
    </StackPanel>
</UserControl>
