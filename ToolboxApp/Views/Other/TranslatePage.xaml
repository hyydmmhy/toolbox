<UserControl x:Class="ToolboxApp.Views.Other.TranslatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="BtnImport" Content="导入 TXT" Click="BtnImport_Click"/>
            <TextBlock Text="目标语言:" VerticalAlignment="Center" Foreground="#666666" Margin="12,0,0,0"/>
            <ComboBox x:Name="CmbTarget" Width="100" SelectedIndex="1" Margin="6,0,0,0" VerticalAlignment="Center">
                <ComboBoxItem Content="简体中文" Tag="zh-Hans"/>
                <ComboBoxItem Content="英语"     Tag="en"/>
                <ComboBoxItem Content="日语"     Tag="ja"/>
                <ComboBoxItem Content="韩语"     Tag="ko"/>
                <ComboBoxItem Content="繁体中文" Tag="zh-Hant"/>
                <ComboBoxItem Content="法语"     Tag="fr"/>
                <ComboBoxItem Content="德语"     Tag="de"/>
                <ComboBoxItem Content="西班牙语" Tag="es"/>
                <ComboBoxItem Content="俄语"     Tag="ru"/>
            </ComboBox>

            <Button x:Name="BtnTranslate" Content="开始翻译" Margin="12,0,0,0" Click="BtnTranslate_Click"/>
            <Button Content="清空" Margin="8,0,0,0" Click="BtnClear_Click"/>
        </StackPanel>

        <!-- 原文 -->
        <DockPanel Grid.Row="1">
            <TextBlock DockPanel.Dock="Top" Text="原文" Foreground="#666666" Margin="2,0,0,4"/>
            <TextBox x:Name="TxtSource" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontSize="13" Padding="6" BorderBrush="#E0E0E0"
                     VerticalContentAlignment="Top"/>
        </DockPanel>

        <!-- 译文分隔 -->
        <Grid Grid.Row="2" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="译文" Foreground="#666666"
                       VerticalAlignment="Center" Margin="2,0,0,0"/>
            <Button Grid.Column="1" x:Name="BtnCopy" Content="复制" Padding="10,3" FontSize="12"
                    Margin="0,0,6,0" Click="BtnCopy_Click"/>
            <Button Grid.Column="2" x:Name="BtnSave" Content="保存" Padding="10,3" FontSize="12"
                    Click="BtnSave_Click"/>
        </Grid>

        <!-- 译文 -->
        <TextBox Grid.Row="3" x:Name="TxtResult"
                 AcceptsReturn="True" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontSize="13" Padding="6" BorderBrush="#E0E0E0"
                 Background="#FAFAFA"
                 VerticalContentAlignment="Top"/>

        <!-- 状态 -->
        <TextBlock Grid.Row="4" x:Name="TxtStatus"
                   Foreground="#666666" FontSize="12" Height="18"
                   Margin="2,8,0,0" Text="粘贴文本或导入 TXT，选择目标语言后点「开始翻译」"/>
    </Grid>
</UserControl>