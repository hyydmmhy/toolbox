<UserControl x:Class="ToolboxApp.Views.Other.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="16">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="年" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtYear" Width="110" Height="32" Text="2026"
                         PreviewTextInput="NumberOnly_PreviewTextInput" LostFocus="TxtYear_LostFocus"/>
                <TextBlock Text="月" Foreground="#666666" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <TextBox x:Name="TxtMonth" Width="80" Height="32" Text="6"
                         PreviewTextInput="TxtMonth_PreviewTextInput" LostFocus="TxtMonth_LostFocus"/>
                <TextBlock Text="日" Foreground="#666666" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <TextBox x:Name="TxtDay" Width="80" Height="32" Text="26"
                         PreviewTextInput="TxtDay_PreviewTextInput" LostFocus="TxtDay_LostFocus"/>
                <TextBlock Text="时" Foreground="#666666" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <TextBox x:Name="TxtHour" Width="80" Height="32"
                         PreviewTextInput="TxtHour_PreviewTextInput" LostFocus="TxtHour_LostFocus"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="计算" Padding="16,8" Click="CalcBtn_Click"/>
                <Button Content="计算当前" Padding="16,8" Margin="8,0,0,0" Click="CalcNowBtn_Click"/>
            </StackPanel>
        </StackPanel>

        <TextBox x:Name="OutputBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="6,4"/>
    </DockPanel>
</UserControl>