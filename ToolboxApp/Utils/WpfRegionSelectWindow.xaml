<Window x:Class="ToolboxApp.Utils.WpfRegionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="#01FFFFFF"
        ShowInTaskbar="False" ResizeMode="NoResize"
        Cursor="Cross">
    <Canvas>
        <Rectangle x:Name="SelRect" Stroke="#FF50AAFF" StrokeThickness="1" Fill="Transparent" Visibility="Collapsed"/>
        <Border x:Name="SizeLabel" Background="#B4000000" CornerRadius="2" Padding="4,2" Visibility="Collapsed">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12"/>
        </Border>
    </Canvas>
</Window>
